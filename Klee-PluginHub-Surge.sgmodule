#!name=Klee PluginHub · Surge
#!desc=可莉插件中心 Loon → Surge 自动转换
#!requirement=CORE_VERSION>=20

[Body Rewrite]
http-response ^https://(hub|pluginhub)\.kelee\.one/list\.json "loon://import\?plugin=(https://kelee\.one/Tool/Loon/Lpx/(.+?)\.lpx)" "surge:///install-module?url=https://script.hub/file/_start_/$1/_end_/$2.sgmodule%3Ftype%3Dloon-plugin%26target%3Dsurge-module%26del%3Dtrue%26jqEnabled%3Dtrue%26pm%3D.%26sni%3D."

[Header Rewrite]
http-request ^https://(hub|pluginhub)\.kelee\.one/list\.json header-del if-none-match

[MITM]
hostname = %APPEND% hub.kelee.one, pluginhub.kelee.one
